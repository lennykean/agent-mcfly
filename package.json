{
  "name": "agent-mcfly",
  "version": "0.0.7",
  "description": "Replay and inspect Codex and Claude Code agent sessions in a live workbench",
  "type": "module",
  "bin": {
    "mcfly": "server/cli.js"
  },
  "files": [
    "server/server.js",
    "server/cli.js",
    "server/mcp.js",
    "server/mcfly-data.js",
    "server/pty.js",
    "server/loaders/claude-code.js",
    "server/loaders/codex.js",
    "ui/dist"
  ],
  "scripts": {
    "dev:server": "node server/server.js",
    "dev:ui": "npm --prefix ui run dev",
    "build": "npm --prefix ui run build",
    "test": "node --test",
    "start": "node server/server.js",
    "prod": "npm run build && node server/server.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lennykean/agent-mcfly.git"
  },
  "homepage": "https://github.com/lennykean/agent-mcfly",
  "keywords": [
    "ai",
    "agent",
    "codex",
    "claude",
    "session-replay"
  ],
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/headless": "^6.0.0",
    "ws": "^8.21.3"
  }
}
